<?xml version="1.0" encoding="utf-8"?>
<!-- Android cannot whitelist address ranges, so cleartext is permitted at the platform level and
     the app enforces Actualist's rule itself (ServerConnectionSecurity): plain http only to
     loopback, RFC 1918, link-local, .local and .ts.net hosts, never to a public host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
