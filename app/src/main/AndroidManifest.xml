<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the user's own Actual server. The demo budget never uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- New Transaction Alerts (Android 13+ asks when the user turns them on). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets Tasker, Routines and other apps send the automation intents (they also need Allow Automation on in Settings). -->
    <permission
        android:name="com.sporez.actualist.android.permission.AUTOMATION"
        android:description="@string/automation_permission_description"
        android:label="@string/automation_permission_label"
        android:protectionLevel="dangerous" />

    <application
        android:name=".ActualistApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Actualist">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OpenID sign-in returns here from the browser, as Actualist's callback scheme does. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="localhost" android:pathPrefix="/openid/" />
            </intent-filter>
            <!-- actualist://open/<route> deep links (budget, spending, reports, account/<id>, ...). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="actualist" android:host="open" />
            </intent-filter>
            <!-- Share target: bank SMS or notification text becomes a prefilled new transaction. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Quick Settings tile: Add expense. -->
        <service
            android:name=".automation.AddExpenseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/tile_add_expense_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Automation API (Tasker, Routines): LOG_TRANSACTION, GET_BALANCES and the other actions in AutomationActions, guarded by a permission and the Allow Automation setting. -->
        <receiver
            android:name=".automation.AutomationReceiver"
            android:exported="true"
            android:permission="com.sporez.actualist.android.permission.AUTOMATION">
            <intent-filter>
                <action android:name="com.sporez.actualist.android.automation.LOG_TRANSACTION" />
                <action android:name="com.sporez.actualist.android.automation.GET_BALANCES" />
                <action android:name="com.sporez.actualist.android.automation.LOG_TRANSFER" />
                <action android:name="com.sporez.actualist.android.automation.UPDATE_TRANSACTION" />
                <action android:name="com.sporez.actualist.android.automation.CATEGORIZE_TRANSACTION" />
                <action android:name="com.sporez.actualist.android.automation.SET_CLEARED" />
                <action android:name="com.sporez.actualist.android.automation.DELETE_TRANSACTION" />
                <action android:name="com.sporez.actualist.android.automation.ASSIGN_BUDGET" />
                <action android:name="com.sporez.actualist.android.automation.ADD_TO_BUDGET" />
                <action android:name="com.sporez.actualist.android.automation.MOVE_MONEY" />
                <action android:name="com.sporez.actualist.android.automation.APPLY_TEMPLATES" />
                <action android:name="com.sporez.actualist.android.automation.SET_CARRYOVER" />
                <action android:name="com.sporez.actualist.android.automation.CREATE_PAYEE" />
                <action android:name="com.sporez.actualist.android.automation.CREATE_ACCOUNT" />
                <action android:name="com.sporez.actualist.android.automation.GET_BUDGET_SUMMARY" />
                <action android:name="com.sporez.actualist.android.automation.GET_CATEGORY_BALANCE" />
                <action android:name="com.sporez.actualist.android.automation.GET_OVERSPENT" />
                <action android:name="com.sporez.actualist.android.automation.GET_UNCATEGORIZED_COUNT" />
                <action android:name="com.sporez.actualist.android.automation.GET_NET_WORTH" />
                <action android:name="com.sporez.actualist.android.automation.GET_CASH_FLOW" />
                <action android:name="com.sporez.actualist.android.automation.GET_RECENT_TRANSACTIONS" />
                <action android:name="com.sporez.actualist.android.automation.GET_UPCOMING_SCHEDULES" />
            </intent-filter>
        </receiver>
        <!-- Budget overview home-screen widget (Jetpack Glance). -->
        <receiver
            android:name=".widget.BudgetWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/budget_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.AccountBalancesWidgetReceiver"
            android:exported="true"
            android:label="@string/account_balances_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/account_balances_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.RecentTransactionsWidgetReceiver"
            android:exported="true"
            android:label="@string/recent_transactions_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_transactions_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.NeedsAttentionWidgetReceiver"
            android:exported="true"
            android:label="@string/needs_attention_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/needs_attention_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.CategoryBalanceWidgetReceiver"
            android:exported="true"
            android:label="@string/category_balance_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/category_balance_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.MonthOverviewWidgetReceiver"
            android:exported="true"
            android:label="@string/month_overview_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/month_overview_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.NetWorthWidgetReceiver"
            android:exported="true"
            android:label="@string/net_worth_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/net_worth_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.QuickActionsWidgetReceiver"
            android:exported="true"
            android:label="@string/quick_actions_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_actions_widget_info" />
        </receiver>
        <activity
            android:name=".widget.config.QuickActionsConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Actualist">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".widget.config.CategoryBalanceConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Actualist">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".widget.config.AccountBalancesConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Actualist">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
